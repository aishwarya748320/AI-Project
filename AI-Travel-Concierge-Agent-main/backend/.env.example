# Database Configuration
# PostgreSQL is the default production target:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/concierge_db

# Fallback SQLite URL for local development/testing without PostgreSQL running:
# DATABASE_URL=sqlite:///./concierge.db

# Application Configuration
APP_ENV=development
API_V1_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
DEBUG=True
 
# Provider Configuration
# Set to 'simulated' for reliable offline demonstration without external API charges
PROVIDER_MODE=simulated

# Optional: Amadeus for Developers API Credentials (leave empty to use simulated provider)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
AMADEUS_TIMEOUT_SECONDS=10
